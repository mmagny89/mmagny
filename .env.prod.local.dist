# Modèle des variables de production. À copier en `.env.prod.local` SUR LE
# SERVEUR, puis à renseigner. Ce dernier n'est jamais committé (§3).
#
# `--env-file` REMPLACE le `.env` racine, il ne s'y ajoute pas : ce fichier
# porte donc TOUTES les clés, pas seulement celles propres à la production.
#
#     docker compose --env-file .env.prod.local \
#       -f compose.yml -f compose.prod.yml up -d --wait

NGINX_VERSION=1.30.4-alpine3.24

# Domaine servi. Pas un secret, mais propre à l'environnement.
SITE_DOMAIN=mmagny.fr

# Les trois valeurs ci-dessous se CONSTATENT sur le serveur, dans la
# configuration statique du Traefik en place. `websecure` et `letsencrypt` sont
# des usages fréquents, pas des constantes : une valeur inventée produit des
# labels que Traefik ignore sans rien journaliser.
#
#   docker network ls
#   docker inspect <conteneur-traefik> | grep -iE 'entrypoint|certificatesresolver'
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
